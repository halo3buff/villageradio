# Village Radio — environment variables (template)
#
# Local dev: copy to .env.local and fill in only what you exercise. In production, secrets live in
# GCP Secret Manager and plain config in Cloud Run env — see docs/admin-deployment-runbook.md.
# NODE_ENV is managed by Next.js / the runtime; do not set it here.

# ── Admin auth — required for the admin panel (Secret Manager in prod) ──────────────
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=        # generate with: node scripts/hash-password.mjs 'a long passphrase'
SESSION_SECRET=             # long random, e.g.: openssl rand -base64 48

# ── Session / hidden entry — optional. Leave COMMENTED OUT to use the defaults.
# (An empty value like `SESSION_TTL_MS=` is NOT the same as unset — it parses to 0/NaN and
#  breaks sessions. Only uncomment a line if you're giving it a real value.)
# SESSION_VERSION=1          # bump to revoke all live sessions
# SESSION_TTL_MS=28800000    # 8h
# ADMIN_LOGIN_PATH=/relay

# ── GCS buckets — plain config (Cloud Run env in prod; access via ADC) ──────────────
CONFIG_BUCKET=              # content manifests; unset → app serves the bundled seed
TRANSMISSIONS_BUCKET=       # private bucket for /transmit uploads

# ── Cloudflare R2 — media writes only (Secret Manager in prod; reads are public) ────
R2_ACCOUNT_ID=
R2_BUCKET=                  # must be the bucket bound to the public pub-…r2.dev URL
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
